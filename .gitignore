# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# SKORA token secrets (contains mint authority private key!)
skora-config.json
skora-config-mainnet.json

# Prize distribution wallet — holds real SOL, private key! NEVER commit
distribution-wallet.json

# Claude Code MCP config (contains Supabase PAT)
.mcp.json

# dApp Store publisher keypair — DO NOT LOSE, DO NOT COMMIT
dapp-store/publisher.json
dapp-store/media/app-release.apk

# Expo / EAS credentials (contains API tokens!)
credentials.json

# Android signing keystores (NEVER commit — losing means losing app identity)
*.keystore
seeker-release.keystore

# Build / dev logs
*.log
expo-start.*

# Git backup snapshots (created by filter-branch operations)
.git.backup-*

# scratch screenshots & local package cache (session debugging)
_scr*.png
_desktop.png
_emuwin*.png
_pkgs/
build-*.log
metro.log
