# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# SKORA token secrets (contains mint authority private key!)
skora-config.json
skora-config-mainnet.json

# Prize distribution wallet — holds real SOL, private key! NEVER commit
distribution-wallet.json

# Claude Code MCP config (contains Supabase PAT)
.mcp.json

# dApp Store publisher keypair — DO NOT LOSE, DO NOT COMMIT
dapp-store/publisher.json
dapp-store/media/app-release.apk

# Expo / EAS credentials (contains API tokens!)
credentials.json

# Android signing keystores (NEVER commit — losing means losing app identity)
*.keystore
seeker-release.keystore

# Build / dev logs
*.log
expo-start.*

# Git backup snapshots (created by filter-branch operations)
.git.backup-*

# scratch screenshots & local package cache (session debugging)
_scr*.png
_desktop.png
_emuwin*.png
_pkgs/
build-*.log
metro.log

# scratch / local test artifacts
_scr*.png
_desktop.png
_emuwin*.png
_emu/
_pkgs/
build-*.log
metro.log

# original full-res art before downscaling (43 MB, regenerable)
assets/labyrinth/_source/

# scratch screenshots from emulator verification (root only)
/_*.png
/_*.log

# Encoding-repair backups — transient, never part of the repo
*.bak

# Any publisher keypair variant - never commit a private key
dapp-store/publisher*.json
dapp-store/*keypair*.json

# Signed release APKs — ~140 MB each, rebuilt from source, never versioned
releases/

# Season Zero refund records — they list players' wallet addresses next to the
# amounts refunded. This repository is public; these stay on the owner's disk.
SEASON-ZERO-REFUNDS.md
supabase-season-zero-refunds.sql

# Private half of the project memory — account names, open vulnerabilities,
# revenue, wallet addresses, device ids. Imported by CLAUDE.md, never versioned.
CLAUDE.local.md
